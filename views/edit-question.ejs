<%- include("partials/header", { title }) %>
<section class="form-card wide">
  <p class="eyebrow">Update your post</p>
  <h1>Edit question</h1>
  <% if (error) { %><div class="alert error" role="alert"><%= error %></div><% } %>
  <form method="post" action="/questions/<%= question.question_id %>/edit">
    <label for="title">Title</label>
    <input id="title" name="title" maxlength="150" required value="<%= question.title || '' %>">
    <label for="body">Question</label>
    <textarea id="body" name="body" rows="8" required><%= question.body || '' %></textarea>
    <div class="form-actions">
      <button class="button" type="submit">Save changes</button>
      <a class="button secondary" href="/questions/<%= question.question_id %>">Cancel</a>
    </div>
  </form>
</section>
<%- include("partials/footer") %>