<%- include("partials/header", { title }) %>
<article class="question-page">
  <p class="eyebrow">Question</p>
  <h1><%= question.title %></h1>
  <p class="meta">Asked by <strong><%= question.username %></strong> · <%= question.created_at %></p>
  <div class="card post-body"><%= question.body %></div>

  <% if (currentUser && currentUser.id === question.uid_user) { %>
    <div class="post-actions">
      <a class="button secondary small" href="/questions/<%= question.question_id %>/edit">Edit question</a>
      <form method="post" action="/questions/<%= question.question_id %>/delete" onsubmit="return confirm('Delete this question and its answers?')">
        <button class="button danger small" type="submit">Delete question</button>
      </form>
    </div>
  <% } %>

  <section class="answers-section">
    <h2><%= answers.length %> <%= answers.length === 1 ? "answer" : "answers" %></h2>
    <% if (answers.length === 0) { %>
      <p class="muted">No answers yet. Could you help?</p>
    <% } %>
    <% answers.forEach((answer) => { %>
      <article class="card answer-card">
        <div class="post-body"><%= answer.body %></div>
        <p class="meta">Answered by <strong><%= answer.username %></strong> · <%= answer.created_at %></p>
        <% if (currentUser && currentUser.id === answer.uid_user) { %>
          <div class="post-actions">
            <a class="button secondary small" href="/answers/<%= answer.answer_id %>/edit">Edit</a>
            <form method="post" action="/answers/<%= answer.answer_id %>/delete">
              <button class="button danger small" type="submit">Delete</button>
            </form>
          </div>
        <% } %>
      </article>
    <% }) %>
  </section>

  <% if (currentUser) { %>
    <section class="form-card answer-form">
      <h2>Add an answer</h2>
      <% if (error) { %><div class="alert error" role="alert">Answer text is required.</div><% } %>
      <form method="post" action="/questions/<%= question.question_id %>/answers">
        <label for="body">Your answer</label>
        <textarea id="body" name="body" rows="6" required></textarea>
        <button class="button" type="submit">Post answer</button>
      </form>
    </section>
  <% } else { %>
    <section class="card callout">
      <p><a href="/login">Log in</a> to add an answer.</p>
    </section>
  <% } %>
</article>
<%- include("partials/footer") %>